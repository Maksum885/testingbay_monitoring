# =============================================================================
# Contoh konfigurasi lingkungan (copy ke .env lalu sesuaikan)
# =============================================================================

# -----------------------------------------------------------------------------
# Aplikasi Laravel
# -----------------------------------------------------------------------------
# APP_NAME — Nama aplikasi (judul, email, cookie session).
APP_NAME=Laravel

# APP_ENV — Lingkungan: local | staging | production (mempengaruhi error detail).
APP_ENV=local

# APP_KEY — Kunci enkripsi Laravel. Generate: php artisan key:generate
APP_KEY=base64:REPLACE_ME_RUN_php_artisan_key_generate

# APP_DEBUG — true = tampilkan stack trace error (hanya untuk development).
APP_DEBUG=true

# APP_URL — URL dasar backend Laravel (tanpa trailing slash).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Proyek ini memakai SQL Server (sqlsrv)
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=db_project
DB_USERNAME=sa
DB_PASSWORD=YourStrongPasswordHere

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Aplikasi ini single-user TANPA login. Session hanya dipakai untuk flash message
# (notifikasi "Saved", dll). SESSION_DRIVER=database menyimpan session di tabel
# sessions; boleh diganti ke `file` jika tidak ingin tabel session.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Broadcast / realtime (Pusher / Echo di browser)
# -----------------------------------------------------------------------------
# BROADCAST_CONNECTION — log = tidak realtime; pusher = update live ke dashboard.
BROADCAST_CONNECTION=pusher

# Kredensial dari dashboard Pusher (https://pusher.com) — ganti dengan milik Anda.
PUSHER_APP_ID=0000000
PUSHER_APP_KEY=your_pusher_app_key_here
PUSHER_APP_SECRET=your_pusher_app_secret_here
PUSHER_APP_CLUSTER=ap1

# Opsional: Soketi / websocket self-hosted (uncomment jika pakai):
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_SCHEME=http

# VITE_PUSHER_* — diekspos ke frontend Vite; wajib sama dengan PUSHER_APP_KEY / CLUSTER.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# VITE_PUSHER_HOST=127.0.0.1
# VITE_PUSHER_PORT=6001
# VITE_PUSHER_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Cache & Redis
# -----------------------------------------------------------------------------
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (opsional)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS S3 (opsional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Vite / frontend (prefix VITE_ = terbaca di resources/js via import.meta.env)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# VITE_API_URL — Base URL API jika frontend dipisah host (tanpa trailing slash).
# VITE_API_URL=http://127.0.0.1:8000

# VITE_DASHBOARD_API_URL — Fallback axios ke /api/dashboard jika fetch utama gagal.
# VITE_DASHBOARD_API_URL=http://127.0.0.1:8000

# VITE_DASHBOARD_USE_DUMMY — true = data demo dari dummy.js (uji UI tanpa PLC/API).
# Termasuk panel "Demo roof".
# false = data nyata dari GET /api/dashboard. Setelah ubah, jalankan npm run dev / build.
VITE_DASHBOARD_USE_DUMMY=false

# -----------------------------------------------------------------------------
# Integrasi PLC (Laravel ↔ python-modbus)
# -----------------------------------------------------------------------------
# PLC_MICROSERVICE_URL — URL layanan python-modbus/FastAPI (referensi admin, port default 8001).
PLC_MICROSERVICE_URL=http://127.0.0.1:8001

# PLC_WEBHOOK_SECRET — Secret header X-PLC-Secret saat python-modbus POST ke /api/plc/webhook.
# HARUS sama dengan PLC_WEBHOOK_SECRET di python-modbus/.env
PLC_WEBHOOK_SECRET=your_32_char_webhook_secret_here

# PLC_BRIDGE_TOKEN — Token query ?token=... untuk GET /api/plc/bridge-devices.
# HARUS sama dengan token di LARAVEL_BRIDGE_DEVICES_URL (python-modbus/.env).
PLC_BRIDGE_TOKEN=your_32_char_bridge_token_here

# Catatan python-modbus (file terpisah: python-modbus/.env):
#   LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/api/plc/webhook
#   PLC_WEBHOOK_SECRET=<sama dengan di atas>
#   LARAVEL_BRIDGE_DEVICES_URL=http://127.0.0.1:8000/api/plc/bridge-devices?token=<PLC_BRIDGE_TOKEN>
#   POLL_INTERVAL_SEC=5
#   MODBUS_PORT=502
